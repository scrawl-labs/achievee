# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web)
# Authorized redirect URIs (both are required):
#   sign-in:           http://localhost:3000/api/auth/callback/google                 https://<your-domain>/api/auth/callback/google
#   connect Calendar:  http://localhost:3000/api/integrations/google/callback         https://<your-domain>/api/integrations/google/callback
# Sign-in asks for openid/email/profile only; Calendar/Tasks scopes are requested by "connect" (see src/lib/googleScopes.ts).
# Enable APIs: Google Calendar API, Google Tasks API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000   # also the base of the connect redirect URI: must be set (exact public origin, no trailing path)
NEXTAUTH_SECRET=            # openssl rand -base64 32; also seals the Google-connect state cookie

# Postgres (Vercel → Storage → Neon; sets this automatically on Vercel). Locally: copy it from the Neon dashboard.
DATABASE_URL=
# Encrypts diary text + expense memos at rest. Required in production.   openssl rand -base64 32
ENCRYPTION_KEY=

# Shown in the privacy policy (Google verification requires a working contact).
NEXT_PUBLIC_CONTACT_EMAIL=
