# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web)
# Redirect URIs: http://localhost:3000/api/auth/callback/google  and  https://<your-domain>/api/auth/callback/google
# Enable APIs: Google Calendar API, Google Tasks API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=            # openssl rand -base64 32

# Postgres (Vercel → Storage → Neon; sets this automatically on Vercel). Locally: copy it from the Neon dashboard.
DATABASE_URL=
# Encrypts diary text + expense memos at rest. Required in production.   openssl rand -base64 32
ENCRYPTION_KEY=

# Shown in the privacy policy (Google verification requires a working contact).
NEXT_PUBLIC_CONTACT_EMAIL=

# LOCAL ONLY (never set these on Vercel): NH Investment & Securities Open API (NHPLUG) key, used by /local/stocks to read current prices.
# The same key can place orders, so keep it in .env.local on this PC only. The page and API return 404 when VERCEL is set or the host is not localhost.
NHPLUG_APP_KEY=
NHPLUG_APP_SECRET=
